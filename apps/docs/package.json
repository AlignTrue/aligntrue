{
  "name": "@aligntrue/docs",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "clean": "rm -rf .next out",
    "build": "pnpm clean && next build --webpack",
    "postbuild": "pagefind --site out --output-path out/_pagefind && cp -r out/_pagefind public/ || true",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aligntrue/ui-base": "workspace:*",
    "@theguild/remark-mermaid": "^0.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "fast-glob": "^3.3.3",
    "lucide-react": "^1.26.0",
    "mermaid": "11.16.1",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@pagefind/default-ui": "^1.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fast-xml-parser": "5.10.1",
    "pagefind": "^1.5.2"
  }
}
