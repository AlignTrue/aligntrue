{
  "name": "aligntrue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=!@aligntrue/web --filter=!@aligntrue/app --filter=!@aligntrue/docs",
    "dev": "pnpm dev:app",
    "dev:app": "pnpm --filter @aligntrue/app dev",
    "dev:docs": "pnpm --filter @aligntrue/docs dev",
    "dev:web": "pnpm --filter @aligntrue/web dev",
    "dev:packages": "pnpm -r --filter ./packages/* --parallel build --watch",
    "generate:repo-files": "node scripts/generate-repo-files.mjs",
    "start:app": "node scripts/start-app.mjs",
    "start:docs": "node scripts/start-docs.mjs",
    "start:web": "node scripts/start-web.mjs",
    "test": "turbo run test",
    "test:fast": "pnpm -r test --reporter=dot --pool=forks",
    "typecheck": "turbo run typecheck",
    "validate:all": "node scripts/validate-all.mjs",
    "validate:ui-tsconfig": "node scripts/validate-ui-tsconfig.mjs",
    "validate:transpile-packages": "node scripts/validate-transpile-packages.mjs",
    "validate:workspace": "node scripts/validate-workspace-protocol.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix && pnpm lint",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:boundary-smoke": "bash scripts/lint-boundary-smoke.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:fast && pnpm validate:workspace && pnpm validate:transpile-packages",
    "ci": "pnpm run pre-ci && pnpm run validate:all && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "ci:errors": "node scripts/check-ci-errors.mjs",
    "codeql:status": "node scripts/check-codeql-status.mjs",
    "dependabot:status": "node scripts/check-dependabot-status.mjs",
    "pre-ci": "node scripts/pre-ci.mjs",
    "verify:workspace-links": "node scripts/verify-workspace-links.mjs",
    "debug:workspace": "node scripts/debug/workspace-types.mjs",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist core/node_modules core/dist host/node_modules host/dist cli/node_modules cli/dist packs/*/node_modules packs/*/dist connectors/*/node_modules connectors/*/dist ui/*/node_modules ui/*/dist apps/*/node_modules apps/*/.next",
    "clean-temp": "find . -type f -name 'temp-*' -not -path '*/node_modules/*' -delete",
    "cleanup:temps": "node scripts/cleanup-test-temps.mjs --delete",
    "cleanup:temps:dry": "node scripts/cleanup-test-temps.mjs --verbose",
    "bootstrap": "pnpm install && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@next/eslint-plugin-next": "^16.2.11",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-xml-parser": "5.10.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "vite": "7.3.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10.26.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "prismjs": ">=1.30.0",
      "js-yaml": ">=4.3.0",
      "read-yaml-file": ">=2.0.0",
      "mdast-util-to-hast": ">=13.2.1",
      "@protobufjs/utf8": "1.1.1",
      "@xmldom/xmldom": "0.9.10",
      "adm-zip": "0.6.0",
      "ajv@6": "6.15.0",
      "brace-expansion@1": "1.1.16",
      "brace-expansion@2": "2.0.3",
      "brace-expansion@4": "5.0.8",
      "dompurify": "3.4.12",
      "fast-uri": "3.1.4",
      "fast-xml-parser": "5.10.1",
      "flatted": "3.4.2",
      "lodash-es": "4.18.1",
      "minimatch@3": "3.1.5",
      "minimatch@9": "9.0.9",
      "minimatch@10": "10.2.5",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "postcss": "8.5.23",
      "protobufjs": "7.6.5",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "rollup": "4.60.3",
      "sharp": "0.35.3",
      "tar": "7.5.21",
      "undici@6": "6.27.0",
      "undici@7": "7.28.0",
      "vite": "7.3.5",
      "yaml": "2.9.0"
    },
    "allowBuilds": {
      "better-sqlite3": true,
      "esbuild": true,
      "onnxruntime-node": true,
      "protobufjs": true,
      "sharp": true
    }
  }
}
